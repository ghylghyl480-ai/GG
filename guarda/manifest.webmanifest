{
  "name": "Guarda Aí",
  "short_name": "Guarda Aí",
  "description": "Guarda links de vídeos do TikTok, Instagram e YouTube com o nome do autor",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0c1211",
  "theme_color": "#0d9488",
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
