{
  "manifest_version": 3,
  "name": "GG Apps",
  "version": "1.0.0",
  "description": "Lançador dos apps GG Studio: FitBot, Meu Time IA, Toca Aí, Meu Clima, vitrine e mais — um clique de distância.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "images/icon-16.png", "48": "images/icon-48.png", "128": "images/icon-128.png" }
